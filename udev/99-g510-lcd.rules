SUBSYSTEM=="hidraw", ENV{ID_VENDOR_ID}=="046d", ENV{ID_MODEL_ID}=="c22e", ENV{ID_USB_INTERFACE_NUM}=="01", MODE="0660", GROUP="input", SYMLINK+="g510-lcd"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Logitech Gaming Keyboard Gaming Keys", SYMLINK+="g510-keys"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="g15::kbd_backlight", RUN+="/bin/chgrp input /sys/class/leds/g15::kbd_backlight/brightness /sys/class/leds/g15::kbd_backlight/multi_intensity", RUN+="/bin/chmod 664 /sys/class/leds/g15::kbd_backlight/brightness /sys/class/leds/g15::kbd_backlight/multi_intensity", RUN+="/home/alextria/Desktop/System-Fixes/G510LCD/scripts/set-backlight-color.sh"
SUBSYSTEM=="leds", KERNEL=="g15::macro_preset*", MODE="0664", GROUP="input"
SUBSYSTEM=="leds", KERNEL=="g15::macro_record", MODE="0664", GROUP="input"
